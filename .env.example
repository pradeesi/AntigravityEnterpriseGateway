# ==============================================================================
# FILE HEADER: Root Environment Override Template — Antigravity Reference Suite
# ==============================================================================
# Purpose:
#   Reference template listing the shared environment variables used across the
#   three modular subdirectories in this repository:
#     1. `./enterprise-gateway/`  (Cloud Run / GKE Proxy + Model Armor & SDP)
#     2. `./vm-provisioning/`     (Linux & Windows GCP Client Workstations)
#     3. `./agy-config/`          (Cross-OS MDM & Workstation Hardening Suite)
#
# Architecture / Context:
#   Each module loads its own tracked `settings.env` (safe non-secret defaults)
#   and optional git-ignored `.env` override file. You can copy this file or
#   the module-specific `.env.example` into `<module>/.env` before running
#   `./install.sh` or `./uninstall.sh`.
#
# Dependencies / Side Effects:
#   Contains ONLY blank or dummy placeholder values. Never commit real `.env`
#   files or live API keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Project & Regional Placement
# ------------------------------------------------------------------------------
# Leave blank ("") to choose interactively from `gcloud projects list`
PROJECT_ID=""
REGION="europe-west1"
ZONE="europe-west1-b"

# ------------------------------------------------------------------------------
# 2. Enterprise Gateway & Model Armor (`./enterprise-gateway/`)
# ------------------------------------------------------------------------------
# Allowed values: "python" | "go"
GATEWAY_RUNTIME="python"
SERVICE_NAME="antigravity-gateway"

# Generate via: openssl rand -base64 32
GATEWAY_API_KEY=""

# Model Armor enforcement: "inline" | "native" | "disabled"
ENABLE_MODEL_ARMOR="true"
MODEL_ARMOR_MODE="inline"
MODEL_ARMOR_TEMPLATE_ID="agy-enterprise-armor"

# ------------------------------------------------------------------------------
# 3. GCP Client Workstation VMs (`./vm-provisioning/`)
# ------------------------------------------------------------------------------
# Allowed values: "both" | "linux" | "windows"
TARGET_OS="both"
LINUX_VM_NAME="antigravity-linux-vm"
WINDOWS_VM_NAME="antigravity-windows-vm"
LINUX_MACHINE_TYPE="e2-standard-4"
WINDOWS_MACHINE_TYPE="e2-standard-4"

# ------------------------------------------------------------------------------
# 4. Workstation MDM & Client Hardening (`./agy-config/`)
# ------------------------------------------------------------------------------
# Populated after deploying `./enterprise-gateway/`
GATEWAY_URL="https://REPLACE_WITH_GATEWAY_URL"
GATEWAY_WIRE_PROTOCOL="genai"
AGY_DEV_USER=""
COST_CENTER="CC-9941-SEC"
CORPORATE_BU="Enterprise-Security"
BILLING_PROJECT_ID=""
