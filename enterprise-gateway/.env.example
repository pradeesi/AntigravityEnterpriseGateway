# ==============================================================================
# FILE HEADER: Local Secret Overrides Template (.env.example)
# ==============================================================================
# Purpose:
#   Template for local, git-ignored secret overrides (`.env`). Copy this file to
#   `.env` (`cp .env.example .env`) when running the Gateway locally or when
#   supplying a pre-generated `GATEWAY_API_KEY` to `./install.sh`.
#
# Architecture / Context:
#   Non-secret operational defaults live in `settings.env`. Any variable defined
#   in `.env` overrides `settings.env` without modifying tracked files.
#
# Dependencies / Side Effects:
#   `.env` is excluded by `.gitignore` and must NEVER be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# BLOCK 1: Ingress Gateway Authentication Secret
# ------------------------------------------------------------------------------
# Leave as REPLACE_WITH_GATEWAY_API_KEY when running `./install.sh` to auto-generate
# a cryptographically random 256-bit key in Google Secret Manager, or set your own
# high-entropy secret (`openssl rand -base64 32`) for local execution.
# Tip: Supports comma-separated multiple keys (e.g., "key_dev_1,key_dev_2") for per-developer attribution.
GATEWAY_API_KEY="REPLACE_WITH_GATEWAY_API_KEY"

# Optional local overrides for `go run .` or `python main.py` (otherwise read from settings.env):
# PROJECT_ID="REPLACE_WITH_PROJECT_ID"
# REGION="europe-west1"
# SKIP_ADC_INIT="false"
# LOG_TELEMETRY_PAYLOADS="false"
# CLOUD_RUN_INGRESS="all"                 # Options: "all" | "internal" | "internal-and-cloud-load-balancing"
# DEFAULT_FLASH_FALLBACK_MODEL="gemini-3.8-flash"
# OPENAI_UPSTREAM_BASE_URL=""

# ------------------------------------------------------------------------------
# BLOCK 2: Optional Antigravity Client Tier-2 Environment Variables (Developer Testing)
# ------------------------------------------------------------------------------
# Export these on a developer workstation to test connecting `agy` CLI to the Gateway:
# AGY_LLM_GATEWAY_URL="https://REPLACE_WITH_GATEWAY_HOST"
# AGY_LLM_GATEWAY_API_KEY="REPLACE_WITH_GATEWAY_API_KEY"
# AGY_LLM_GATEWAY_WIRE_PROTOCOL="genai"   # Options: "genai" (default; required for ACP) | "openai"
# AGY_LLM_GATEWAY_CA_CERT="/etc/ssl/certs/ca-certificates.crt"
# AGY_LLM_GATEWAY_HEADERS="X-Cost-Center: Platform-Engineering,X-Corporate-BU: DevTools"
# AGY_LLM_GATEWAY_MODELS="gemini-4-argon-high,gemini-4-argon-medium,gemini-4-argon-low,gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.7-flash,gemini-3.1-flash-lite"
