# ==============================================================================
# FILE HEADER: Unified Settings File — Antigravity Enterprise Gateway
# ==============================================================================
# Purpose:
#   Single source of truth for all non-secret configuration defaults across the
#   Enterprise Gateway (Go & Python runtimes), Google Cloud Model Armor + Cloud
#   SDP (DLP) security templates, and Cloud Run deployment/uninstallation scripts.
#
# Architecture / Context:
#   Loaded automatically by `install.sh`, `uninstall.sh`,
#   `model-armor-sdp/model_armor_manager.sh`, `go/main.go`, and
#   `python/routing_and_armor.py`.
#   Precedence order (highest to lowest):
#     1. CLI flags (`--project=...`, `--runtime=...`, etc.) / OS environment vars
#     2. Local `.env` file (git-ignored; used for secrets like `GATEWAY_API_KEY`)
#     3. This `settings.env` file (default values; editable directly or interactively)
#
# Dependencies / Side Effects:
#   Contains zero secrets or credentials. Safe to commit to version control.
# ==============================================================================

# ==============================================================================
# BLOCK 1: TARGET GCP ENVIRONMENT & GATEWAY RUNTIME SELECTION
# ==============================================================================
# Leave PROJECT_ID blank ("") so `./install.sh` and `./uninstall.sh` list all
# accessible GCP projects and prompt you to choose one interactively, or set a
# default GCP Project ID here (can still be changed during interactive install).
PROJECT_ID=""

# Default GCP region for Cloud Run and regional Model Armor / Cloud SDP templates
REGION="europe-west1"

# Gateway implementation to deploy to Cloud Run ("python" or "go")
GATEWAY_RUNTIME="python"

# TCP port on which the Gateway HTTP server listens inside the container / host
PORT="8080"

# Structured JSON log verbosity ("INFO" for production, "DEBUG" for request tracing)
LOG_LEVEL="INFO"

# Set to "true" ONLY for offline local unit/contract tests without GCP credentials
SKIP_ADC_INIT="false"

# Emit parsed client telemetry payloads (/v1internal:recordCodeAssistMetrics,
# /v1internal:registerInteraction, /v1internal:recordInteraction, /v1beta:*) as
# structured JSON stdout logs (event_type="antigravity_client_telemetry") for
# Cloud Logging -> BigQuery / Splunk / Datadog SIEM ingestion ("true" or "false")
LOG_TELEMETRY_PAYLOADS="false"

# ==============================================================================
# BLOCK 2: CLOUD RUN, IAM & SECRET MANAGER SETTINGS
# ==============================================================================
# Cloud Run service name
SERVICE_NAME="antigravity-gateway"

# Dedicated GCP Service Account name (email becomes <SA_NAME>@<PROJECT_ID>.iam.gserviceaccount.com)
SA_NAME="agy-gateway-sa"

# Secret Manager secret name storing the ingress GATEWAY_API_KEY bearer token
# (supports a single key or comma-separated per-developer keys)
SECRET_NAME="agy-gateway-api-key"

# Cloud Run network ingress restriction ("all" for lab/internet testing;
# "internal" or "internal-and-cloud-load-balancing" for private corporate VPCs)
CLOUD_RUN_INGRESS="all"

# Cloud Run container sizing, scaling, and SSE streaming timeout (3600s = 60 mins)
CLOUD_RUN_CPU="1"
CLOUD_RUN_MEMORY="512Mi"
CLOUD_RUN_MIN_INSTANCES="1"
CLOUD_RUN_MAX_INSTANCES="10"
CLOUD_RUN_TIMEOUT="3600"

# ==============================================================================
# BLOCK 3: GOOGLE CLOUD MODEL ARMOR & CLOUD SDP (DLP) SECURITY SETTINGS
# ==============================================================================
# Provision and enforce Google Cloud Model Armor + Cloud SDP templates ("true" or "false")
ENABLE_MODEL_ARMOR="true"

# Enforcement mode when ENABLE_MODEL_ARMOR="true":
#   - "inline" : Pre-flight `:sanitizeUserPrompt` callout with conversational HTTP 200
#                policy blocks, multi-turn history scrubbing, and in-place PII redaction.
#   - "native" : Injects `modelArmorConfig` directly into Vertex AI generateContent payloads.
#   - "disabled": Bypasses Model Armor enforcement at runtime.
MODEL_ARMOR_MODE="inline"

# Reject requests with HTTP 502 if Model Armor API is unreachable in "inline" mode
MODEL_ARMOR_FAIL_CLOSED="true"

# Regional Cloud SDP (DLP) and Model Armor template identifiers
SDP_INSPECT_TEMPLATE_ID="agy-pci-creds-pii-inspect"
SDP_DEID_TEMPLATE_ID="agy-pci-creds-pii-deid"
MODEL_ARMOR_TEMPLATE_ID="agy-enterprise-armor"

# Run the 5-test live `:sanitizeUserPrompt` verification suite during installation
RUN_VERIFICATION_TESTS="true"

# ==============================================================================
# BLOCK 4: DYNAMIC ENDPOINT ROUTING, M50 FALLBACK & OPENAI PROTOCOL SETTINGS
# ==============================================================================
# Comma-separated X-Cost-Center=PROJECT_ID chargeback routing map
# Example: "Platform-Engineering=cymbal-plat-prod,Finance=cymbal-fin-prod"
COST_CENTER_PROJECT_MAP=""

# Comma-separated MODEL_ID=REGION routing map (Gemini 4 & 3.x default to "global" if unset)
# Example: "gemini-3.8-flash=europe-west1,gemini-3.1-pro-preview=global"
MODEL_REGION_MAP=""

# Comma-separated secondary regions retried automatically on upstream HTTP 429 or 503
# Example: "europe-west4,europe-west3"
FAILOVER_REGIONS=""

# Fallback Flash model automatically substituted if an older or misconfigured client
# sends an unmapped `MODEL_PLACEHOLDER_M50` / `MODEL_PLACEHOLDER_*` enum during
# background conversation titling or trajectory checkpointing
DEFAULT_FLASH_FALLBACK_MODEL="gemini-3.8-flash"

# Optional custom OpenAI-compatible upstream base URL for `wireProtocol: "openai"`
# (`POST /v1/chat/completions`), e.g., "https://litellm.internal.corp/v1".
# When empty (""), `/v1/chat/completions` routes natively to Vertex AI's OpenAI
# Chat Completions endpoint (`/v1beta1/projects/{PROJECT}/locations/{REGION}/endpoints/openapi/chat/completions`).
OPENAI_UPSTREAM_BASE_URL=""

# ==============================================================================
# BLOCK 5: UNINSTALLATION DEFAULTS (Used by ./uninstall.sh)
# ==============================================================================
DELETE_CLOUD_RUN_SERVICE="true"
DELETE_MODEL_ARMOR_SDP="true"
DELETE_SECRET="false"
DELETE_SERVICE_ACCOUNT="false"
