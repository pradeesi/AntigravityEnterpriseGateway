        {"name": "CREDIT_CARD_EXPIRATION_DATE"},
        {"name": "IBAN_CODE"},
        {"name": "SWIFT_CODE"},
        {"name": "FINANCIAL_ACCOUNT_NUMBER"},
        {"name": "US_BANK_ROUTING_MICR"},
        {"name": "AUTH_TOKEN"},
        {"name": "AWS_CREDENTIALS"},
        {"name": "AZURE_AUTH_TOKEN"},
        {"name": "GCP_API_KEY"},
        {"name": "GCP_CREDENTIALS"},
        {"name": "JSON_WEB_TOKEN"},
        {"name": "OAUTH_CLIENT_SECRET"},
        {"name": "PASSWORD"},
