{
  "templateId": "agy-pci-creds-pii-inspect",
  "inspectTemplate": {
    "displayName": "Antigravity Broad-Spectrum Enterprise Security, PCI, Credentials & PII Inspector",
    "description": "Broad-spectrum detectors for PCI, credentials, PII, and 14 security domains (Recon, Vuln/Pentest, Privesc, DoS, Evasion, Ransomware, Phishing, Cloning, Impersonation, Cleartext/DLP Bypass, Secret File Read, File Hunt, File Encrypt, File Delete).",
    "inspectConfig": {
