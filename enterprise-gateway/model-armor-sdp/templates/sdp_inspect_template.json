          "regex": {
            "pattern": "(?i)\\b(nmap|masscan|zmap|rustscan|unicornscan|nikto|nessus|openvas|qualys|nexpose|acunetix|burp\\s*suite|owasp\\s+zap|zaproxy|nuclei|gobuster|dirbuster|feroxbuster|ffuf|wfuzz|sqlmap|wpscan|metasploit|msfconsole|msfvenom|shodan|censys|maltego|recon-ng|theharvester|amass|subfinder|port\\s+scan(s|ning|ner|ners)?|va\\s+scan(s|ning)?|service\\s+enumeration|banner\\s+grab(s|bing)?|subnet\\s+sweep(s|ing)?|syn\\s+scan(s|ning)?|arp\\s+scan(s|ning)?|socket\\.connect_ex)\\b"
          }
        },
        {
          "infoType": {"name": "CUSTOM_SEC_VULNERABILITY_PENTEST_AND_EXPLOIT"},
          "likelihood": "VERY_LIKELY",
          "regex": {
            "pattern": "(?i)\\b(vulnerabilit(y|ies)|vuln(s|erable)?|cve-[0-9]{4}-[0-9]+|cwe-[0-9]+|zero[- ]day|0[- ]?day|security\\s+(flaw|weakness|hole|defect)s?|attack\\s+(surface|vector)s?|penetration\\s+test(s|ing|er|ers)?|pen[- ]?test(s|ing|er|ers)?|offensive\\s+(security|penetration|test(s|ing)?|cyber|hack(ing)?|operations?)|red[- ]?team(s|ing|er|ers)?|adversary\\s+(simulation|emulation)|ethical\\s+hack(ing|er|ers)?|exploit(s|ed|ing|ation|able|ability|-based)?|searchsploit|exploit-db|weaponiz(e|ed|ing|ation)|shellcode|rop\\s+chain|buffer\\s+overflow|heap\\s+spray|sql\\s+injection|sqli|cross-site\\s+scripting|xss|remote\\s+code\\s+execution|command\\s+injection|path\\s+traversal|directory\\s+traversal|ssrf|xxe)\\b"
          }
        },
        {
          "infoType": {"name": "CUSTOM_SEC_PRIVILEGE_ESCALATION_AND_AUTH_BYPASS"},
          "likelihood": "VERY_LIKELY",
