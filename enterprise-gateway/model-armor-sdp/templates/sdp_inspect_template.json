{
  "templateId": "agy-pci-creds-pii-inspect",
  "inspectTemplate": {
    "displayName": "Antigravity Broad-Spectrum Enterprise Security, PCI, Credentials & PII Inspector",
    "description": "Broad-spectrum enterprise detectors for PCI, credentials, PII, and 8 security domains (Recon, Vuln/Pentest, Privesc, DoS/DDoS, Evasion/Malware, Ransomware, Phishing/Spoofing, Website Cloning/Copying).",
    "inspectConfig": {
