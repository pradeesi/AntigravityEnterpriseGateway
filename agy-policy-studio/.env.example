# ==============================================================================
# FILE HEADER: Environment Template — Antigravity Admin Policy Studio
# ==============================================================================
# Purpose:
#   Template defining all externalized runtime configuration variables for the
#   Antigravity Admin Policy Studio Flask application.
#
# Architecture / Context:
#   Copy this file to `.env` for local overrides (`cp .env.example .env`).
#   `.env` is git-ignored so credentials and environment-specific settings are
#   never committed to version control.
#
# Dependencies / Side Effects:
#   Loaded automatically via `python-dotenv` in `app.py` without overriding
#   existing OS/container environment variables.
# ==============================================================================

# Bind host and port (`PORT` is automatically injected on Google Cloud Run)
FLASK_HOST="0.0.0.0"
PORT="8090"

# Enable Flask debug mode ONLY during local development ("true" or "false")
FLASK_DEBUG="false"

# Structured log verbosity ("DEBUG", "INFO", "WARNING", "ERROR")
LOG_LEVEL="INFO"

# Maximum file/ZIP import payload size in MiB (stateless in-memory parsing)
MAX_UPLOAD_MB="16"

# Optional default workstation developer username (leave blank to require explicit entry for user-scoped files)
DEFAULT_DEV_USER=""

# Optional relative or absolute path to sibling canonical baseline configs
REPO_BASELINE_DIR="../agy-config/configs"
