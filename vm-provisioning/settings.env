# ==============================================================================
# FILE HEADER: Unified Settings File — GCP Antigravity Client VM Provisioning
# ==============================================================================
# Author: Pradeep Singh
# License: Apache-2.0
#
# Purpose:
#   Single source of truth for all non-secret configuration defaults across the
#   Google Compute Engine (GCE) Linux and Windows client VM provisioning and
#   deprovisioning scripts (`install.sh`, `uninstall.sh`, `linux/*.sh`, and
#   `windows/*.sh`).
#
# Architecture / Context:
#   Loaded automatically by `common/gcp_vm_lib.sh` before applying optional
#   local `.env` overrides and command-line flags.
#   Precedence order (highest to lowest):
#     1. CLI flags (`--project=...`, `--os=...`, `--zone=...`, etc.) / shell env
#     2. Local `.env` file (git-ignored; optional workstation-local overrides)
#     3. This `settings.env` file (default values; editable directly or via prompt)
#
# Dependencies / Side Effects:
#   Contains zero secrets, hardcoded project IDs, or live IP addresses. Safe to
#   commit to version control.
# ==============================================================================

# ==============================================================================
# BLOCK 1: TARGET GCP PROJECT, REGION/ZONE & OPERATING SYSTEM SELECTION
# ==============================================================================
# Leave PROJECT_ID blank ("") so `./install.sh`, `./uninstall.sh`, and OS scripts
# list all accessible GCP projects via `gcloud projects list` and prompt you to
# select one interactively.
PROJECT_ID=""

# Which client VMs to provision or tear down via `./install.sh` / `./uninstall.sh`
# Supported values: "both" | "linux" | "windows"
TARGET_OS="both"

# Default Compute Engine region and availability zone
REGION="europe-west1"
ZONE="europe-west1-b"

# ==============================================================================
# BLOCK 2: LINUX CLIENT VM SIZING & OS IMAGE DEFAULTS (Ubuntu 22.04 LTS)
# ==============================================================================
LINUX_VM_NAME="antigravity-linux-vm"
LINUX_MACHINE_TYPE="e2-standard-4"
LINUX_DISK_SIZE="50GB"
LINUX_DISK_TYPE="pd-balanced"
LINUX_IMAGE_FAMILY="ubuntu-2204-lts"
LINUX_IMAGE_PROJECT="ubuntu-os-cloud"

# ==============================================================================
# BLOCK 3: WINDOWS CLIENT VM SIZING & OS IMAGE DEFAULTS (Windows Server 2022)
# ==============================================================================
WINDOWS_VM_NAME="antigravity-windows-vm"
WINDOWS_MACHINE_TYPE="e2-standard-4"
WINDOWS_DISK_SIZE="60GB"
WINDOWS_DISK_TYPE="pd-balanced"
WINDOWS_IMAGE_FAMILY="windows-2022"
WINDOWS_IMAGE_PROJECT="windows-cloud"
WINDOWS_ADMIN_USER="agyadmin"

# ==============================================================================
# BLOCK 4: SHARED VPC NETWORKING, FIREWALL & WEB UI PORT SETTINGS
# ==============================================================================
# Network tag attached to both Linux and Windows client VMs for shared ingress
NETWORK_TAG="antigravity-client-vm"

# Tag-scoped VPC firewall rule allowing SSH (22), RDP (3389), and Web UI (4400)
FIREWALL_RULE="antigravity-client-vms-allow-access"

# Public port served by Nginx on Linux (and allowed on Windows) for `agy --hub`
HUB_WEB_PORT="4400"

# ==============================================================================
# BLOCK 5: LIFECYCLE & RECREATION BEHAVIOR DEFAULTS
# ==============================================================================
# Automatically delete and recreate an existing VM of the same name ("true"/"false")
AUTO_RECREATE="false"

# Skip confirmation prompt during deprovisioning ("true"/"false")
AUTO_APPROVE="false"
