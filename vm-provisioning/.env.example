# ==============================================================================
# FILE HEADER: Local Environment Override Template — GCP VM Provisioning
# ==============================================================================
# Author: Pradeep Singh
# License: Apache-2.0
#
# Purpose:
#   Optional workstation-local override template for GCP Compute Engine VM
#   provisioning and teardown (`install.sh`, `uninstall.sh`, `linux/*.sh`, and
#   `windows/*.sh`).
#
# Architecture / Context:
#   Copy this file to `.env` inside `New/vm-provisioning/` to pin a local target
#   `PROJECT_ID`, `TARGET_OS`, `ZONE`, or machine type without modifying tracked
#   defaults in `settings.env`.
#
# Dependencies / Side Effects:
#   `.env` is git-ignored and sourced automatically after `settings.env`.
# ==============================================================================

PROJECT_ID="REPLACE_WITH_PROJECT_ID"
TARGET_OS="both"  # Allowed values: "both" | "linux" | "windows"
REGION="europe-west1"
ZONE="europe-west1-b"

LINUX_VM_NAME="antigravity-linux-vm"
LINUX_MACHINE_TYPE="e2-standard-4"
LINUX_DISK_SIZE="50GB"

WINDOWS_VM_NAME="antigravity-windows-vm"
WINDOWS_MACHINE_TYPE="e2-standard-4"
WINDOWS_DISK_SIZE="60GB"
WINDOWS_ADMIN_USER="agyadmin"

NETWORK_TAG="antigravity-client-vm"
FIREWALL_RULE="antigravity-client-vms-allow-access"
HUB_WEB_PORT="4400"
