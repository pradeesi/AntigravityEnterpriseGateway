# ==============================================================================
# FILE HEADER: Unified Settings File — Antigravity Client & MDM Security Config
# ==============================================================================
# Purpose:
#   Single source of truth for all non-secret enterprise configuration defaults
#   used by `install.sh`, `uninstall.sh`, and `scripts/deploy_and_lock_*.{sh,ps1}`
#   when rendering and locking Antigravity configuration files on Linux, macOS,
#   and Windows workstations.
#
# Architecture / Context:
#   Loaded automatically by `install.sh`, `uninstall.sh`, and the OS-specific
#   deployment scripts in `scripts/`. Values can be overridden via a local
#   git-ignored `.env` file, environment variables, or CLI flags (`--user`,
#   `--gateway-url`, etc.).
#
# Dependencies / Side Effects:
#   Contains zero live API keys, personal usernames, or hardcoded project IDs.
#   Safe to commit to version control.
# ==============================================================================

# ==============================================================================
# BLOCK 1: TARGET DEVELOPER WORKSTATION ACCOUNT & WORKSPACE
# ==============================================================================
# Target non-root developer OS username. Leave blank ("") to auto-detect from
# SUDO_USER / /dev/console / Win32_ComputerSystem or prompt interactively.
AGY_DEV_USER=""

# Optional custom workspace directory name inside the developer's home folder
# (e.g., "workspace" resolves to /home/<user>/workspace, /Users/<user>/workspace,
# or C:/Users/<user>/workspace).
AGY_WORKSPACE_SUBDIR="workspace"

# ==============================================================================
# BLOCK 2: ENTERPRISE GATEWAY CONNECTION & ATTRIBUTION DEFAULTS
# ==============================================================================
# HTTPS endpoint of your deployed Antigravity Enterprise Gateway (Cloud Run / GKE / LB).
# Leave as placeholder or override in `.env` / `--gateway-url`.
GATEWAY_URL="https://REPLACE_WITH_GATEWAY_URL"

# Wire protocol used between Antigravity client and Enterprise Gateway.
# Allowed values: "genai" (default; required for JetBrains & Zed ACP) | "openai"
GATEWAY_WIRE_PROTOCOL="genai"

# Default corporate TLS Root CA bundle path (auto-adjusted to /etc/ssl/cert.pem on macOS
# if unchanged from the Linux default).
CA_CERT_PATH="/etc/ssl/certs/ca-certificates.crt"

# Custom HTTP headers injected into `admin_settings.json` -> `gateway.customHeaders`
# for FinOps chargeback, SIEM attribution, and Vertex AI quota project routing.
COST_CENTER="CC-9941-SEC"
CORPORATE_BU="Enterprise-Security"
ENTERPRISE_SURFACE="MDM-Managed-Workstation"
BILLING_PROJECT_ID="REPLACE_WITH_PROJECT_ID"

# ==============================================================================
# BLOCK 3: APPROVED ENTERPRISE MODEL CATALOG DEFAULTS
# ==============================================================================
# Default model selected in Antigravity App, CLI (`agy`), and IDE extensions
DEFAULT_MODEL_ID="gemini-3.8-flash"

# Comma-separated list of approved models injected into ACP `AGY_LLM_GATEWAY_MODELS`
APPROVED_MODELS_CSV="gemini-4-argon-high,gemini-4-argon-medium,gemini-4-argon-low,gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.7-flash,gemini-3.1-flash-lite"

# ==============================================================================
# BLOCK 4: OPTIONAL SURFACES & RUNTIME SECURITY GUARD SETTINGS
# ==============================================================================
# Deploy JetBrains (`~/.jetbrains/acp.json`) and Zed (`settings.json`) ACP configs
# alongside CLI and Desktop App policies. Allowed values: "true" | "false"
DEPLOY_ACP_CONFIGS="true"

# On Windows, native OS terminal sandboxing requires Windows 11 24H2 (Aug 2026+).
# When "true", `deploy_and_lock_windows.ps1` appends matching `unsandboxed(...)`
# allow grants for explicitly approved `command(...)` entries on Windows hosts.
WINDOWS_ADD_UNSANDBOXED_ALLOW="true"

# Path where `agy_security_guard.sh` writes local JSONL SIEM audit logs on Linux/macOS
AGY_AUDIT_LOG_PATH="/tmp/agy_security_audit.log"
