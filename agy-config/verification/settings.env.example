# ==============================================================================
# settings.env.example — configuration for the AGY settings-scope verification
# Copy to settings.env (git-ignored) and fill in. Never commit real values.
# ==============================================================================

# Google Cloud project that hosts the gateway and the disposable test VMs.
PROJECT_ID=your-project-id
# Zone, VPC network and subnet for the test VMs (IAP-only access, no public ports).
ZONE=europe-west1-b
NETWORK=your-vpc-network
SUBNET=your-subnet
# Firewall rule and network tag that allow SSH/RDP only from the IAP range 35.235.240.0/20.
FIREWALL_RULE=agy-scope-allow-iap
NETWORK_TAG=agy-scope-iap
# Test VM names and machine type.
LINUX_VM=agy-scope-linux
WINDOWS_VM=agy-scope-windows
MACHINE_TYPE=e2-standard-8

# Enterprise Gateway the clients are pointed at (HTTPS only).
GATEWAY_URL=https://your-gateway.example.com
# Path to a local file that holds the gateway API key (the key itself never goes here).
GATEWAY_API_KEY_FILE=/path/to/gateway_api_key.txt
# Model Armor template used by the gateway (only needed for prompt pre-screening).
MODEL_ARMOR_REGION=europe-west1
MODEL_ARMOR_TEMPLATE=your-model-armor-template
