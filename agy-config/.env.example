# ==============================================================================
# FILE HEADER: Local Secret & Environment Override Template (.env.example)
# ==============================================================================
# Purpose:
#   Template for workstation-local or CI/MDM secret overrides. Copy to `.env`
#   (`cp .env.example .env`) and populate `GATEWAY_API_KEY` and `GATEWAY_URL`
#   before running `sudo ./install.sh`.
#
# Architecture / Context:
#   `.env` is git-ignored by `.gitignore` and overrides defaults in `settings.env`.
#
# Dependencies / Side Effects:
#   Never commit `.env` with real API keys to source control.
# ==============================================================================

# Target developer username (leave empty to auto-detect or prompt interactively)
AGY_DEV_USER=""

# Live Enterprise Gateway HTTPS URL (no trailing slash)
GATEWAY_URL="https://gateway.corp.example.com"

# Shared or per-developer Bearer token validated by the Enterprise Gateway
GATEWAY_API_KEY="REPLACE_WITH_GATEWAY_API_KEY"

# Wire protocol ("genai" | "openai" — note: JetBrains/Zed ACP requires "genai")
GATEWAY_WIRE_PROTOCOL="genai"

# Corporate FinOps & GCP Quota Attribution Headers
COST_CENTER="CC-9941-SEC"
CORPORATE_BU="Enterprise-Security"
ENTERPRISE_SURFACE="MDM-Managed-Workstation"
BILLING_PROJECT_ID="your-gcp-billing-project-id"

# Deploy JetBrains & Zed ACP configs ("true" | "false")
DEPLOY_ACP_CONFIGS="true"
